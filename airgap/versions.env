# Single source of truth for the pinned toolchain.
#
# Sourced by airgap/Dockerfile (via --build-arg), the Makefile, and CI. The
# table in BUILDING.md must agree with this file; `make airgap-versions`
# re-derives each value from its real upstream source and fails on drift.
#
# Verified against tag component/v0.1.5 (e7efde4).

# --- what we build ---------------------------------------------------------

# Latest released SDK. Every example and the template must require exactly this.
SDK_VERSION=v0.1.5

# --- toolchain -------------------------------------------------------------

# Stock Go. Builds the sync WASI P2 examples. componentize-go's
# check_go_version() requires major==1 && minor>=25.
GO_VERSION=1.25.5

# wash, from wasmCloud/wasmCloud releases (not wasmCloud/wash).
WASH_VERSION=v2.9.0

# --- componentize-go -------------------------------------------------------
#
# The Go module is a downloader whose main.go hardcodes `release := "..."`; that
# release is the Rust binary that actually builds the component. A tagged
# release names itself, so these two agree and there is nothing to watch. Keep
# it that way: pin a tag, never a pseudo-version, which would name the release
# *before* it and silently build with an older toolchain. See BUILDING.md.

# The `tool` dependency in every example's go.mod.
COMPONENTIZE_GO_MODULE=v0.4.2

# What the above module's main.go fetches and runs. Must match the module.
COMPONENTIZE_GO_BINARY=v0.4.2

# Pinned inside COMPONENTIZE_GO_BINARY's Cargo.toml / Cargo.lock. Nothing in
# the Go module graph mentions these, so they can only be read from there.
WIT_BINDGEN_GO=0.61.1
WIT_BINDGEN_REV=4f9a02d74cec9257c14ba9b160fa787a3523fd0b
WIT_COMPONENT=0.258.0

# --- the patched Go --------------------------------------------------------
#
# Upstream Go cannot build async WASI P3 worlds at all (golang/go#76775 is
# still open), so componentize-go substitutes a patched toolchain for the six
# async examples. COMPONENTIZE_GO_BINARY downloads this tag on its own; if you
# change it to one the binary does not know about (go1.27.1-wasi-on-idle, say),
# the Dockerfile fetches it directly instead. See BUILDING.md.
PATCHED_GO_TAG=go1.25.5-wasi-on-idle-v2

# --- other libraries -------------------------------------------------------

GO_PKG=v0.2.4-0.20260806154504-91f6c4863e67
