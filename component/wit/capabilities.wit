// Bindings-generation worlds for the wasmCloud host-plugin capability
// interfaces (vendored under deps/ from wasmCloud v2.6.1).
//
// These worlds exist only so regenerate_bindings.sh can generate the import
// bindings under imports/ and the export glue under exports/. They are NOT
// build targets and the capability imports are deliberately kept out of the
// default `wasip2`/`wasip3` worlds: an app opts in to a capability by
// declaring the import in its own world, and the workload manifest must
// declare the matching `hostInterfaces` entry.

// Everything a component may import from a wasmCloud host plugin.
world wasmcloud-capabilities {
  // wasmcloud:secrets — opaque secret handles, revealed on demand.
  import wasmcloud:secrets/store@2.0.0;
  import wasmcloud:secrets/reveal@2.0.0;

  // wasmcloud:keyvalue — bucket CRUD, atomics, CAS, and batch operations.
  import wasmcloud:keyvalue/types@0.1.0;
  import wasmcloud:keyvalue/store@0.1.0;
  import wasmcloud:keyvalue/atomics@0.1.0;
  import wasmcloud:keyvalue/cas@0.1.0;
  import wasmcloud:keyvalue/batch@0.1.0;

  // wasmcloud:messaging — publish/request on a message broker.
  import wasmcloud:messaging/types@0.2.0;
  import wasmcloud:messaging/consumer@0.2.0;

  // wasmcloud:postgres — parameterized queries and prepared statements.
  import wasmcloud:postgres/types@0.2.0;
  import wasmcloud:postgres/query@0.2.0;
  import wasmcloud:postgres/prepared@0.2.0;

  // wasmcloud:blobstore — containers of byte objects with streaming bodies.
  import wasmcloud:blobstore/types@0.1.0;
  import wasmcloud:blobstore/container@0.1.0;
  import wasmcloud:blobstore/blobstore@0.1.0;

  // wasmcloud:nats — NATS-native core pub/sub, JetStream, and KV. Distinct
  // from wasmcloud:messaging: durable delivery, explicit acknowledgement,
  // and compare-and-swap on a KV revision, none of which the portable
  // messaging interface can express. Every function is an `async func`, so a
  // component importing it targets WASI P3.
  import wasmcloud:nats/types@0.1.0;
  import wasmcloud:nats/core@0.1.0;
  import wasmcloud:nats/jetstream@0.1.0;
  import wasmcloud:nats/kv@0.1.0;
}

// Export-glue world for the optional wasmcloud:messaging handler callback.
// An app that wants to receive messages exports this interface from its own
// world and registers a callback via go.wasmcloud.dev/component/messaging.
world wasmcloud-messaging-handler {
  export wasmcloud:messaging/handler@0.2.0;
}

// Export-glue worlds for the wasmcloud:nats handler callbacks. Each is
// separate so a component exporting only one of them still instantiates —
// a single world covering all three would force every component to export
// all three.
world wasmcloud-nats-core-handler {
  export wasmcloud:nats/core-handler@0.1.0;
}

world wasmcloud-nats-jetstream-handler {
  export wasmcloud:nats/jetstream-handler@0.1.0;
}

world wasmcloud-nats-kv-handler {
  export wasmcloud:nats/kv-handler@0.1.0;
}
