package wasmcloud:examples@0.1.0;

// The responder serves no HTTP, so it does not merge the SDK's wasip2 world
// (which mandates a wasi:http/incoming-handler export) and includes the CLI
// imports directly instead.
world nats-reply-service {
  include wasi:cli/imports@0.2.8;

  import wasi:logging/logging@0.1.0-draft;

  import wasmcloud:nats/types@0.1.0;
  // Replies go back out over core NATS, to the subject the request named.
  import wasmcloud:nats/core@0.1.0;

  export wasmcloud:nats/core-handler@0.1.0;
}
