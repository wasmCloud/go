package wasmcloud:examples@0.1.0;

// Extra interfaces this component needs beyond the SDK's wasip2 world:
// the wasmCloud host's wasi_otel plugin serves wasi:otel, receiving span
// lifecycle events from the component.
world http-otel {
  import wasi:otel/types@0.2.0-rc.2;
  import wasi:otel/tracing@0.2.0-rc.2;
}
